	2.2录波过程	
	2.2.1录波启动
	(
		上行:
		{
			"FunType": "Report",	
			"FunCode": "RecStart",
			"Data": {
				"RecFile": "\...\xxx.dat",						//录波文件所在路径及文件名，约定用 .dat 作为文件扩展名；
																			//文件名缺省按： YYYYMMDDHHNNSS.dat / YYYYMMDDHHNNSS.cfg 形式命名，其时刻为粗略到秒的录波开始时刻，更精确的时刻在cfg文件中描述。
				"RecFrom":"StateSequence"/"WaveformReplay"/"DI", 		//录波来源，DI指专用于启动录波的开入节点从0变位1的信号？
				"RecDuration": 30000,						//预估录波时长，单位ms，无法确定时用-1表示？
				"ErrInfo": "InsufficientStorage"			//仅启动失败时包含该属性。如：磁盘空间不足。
			}
		}
	)
	2.2.2录波完成
	(
		上行:
		{
			"FunType": "Report",	
			"FunCode": "RecComplete",	
			"Data": {
				"RecFile": "\...\xxx.dat",						//录波文件所在路径及文件名，约定用 .dat 作为文件扩展名；
																			//文件名缺省按： YYYYMMDDHHNNSS.dat / YYYYMMDDHHNNSS.cfg 形式命名，其时刻为粗略到秒的录波开始时刻，更精确的时刻在cfg文件中描述。
				"RecFrom":"StateSequence"/"WaveformReplay"/"DI" 		//录波来源
				"FileSizeDat": 123456,							//Dat文件字节数（Binary）
				"FileSizeCfg": 789,								//Cfg文件字节数（ASCII）
			}
		}
	)

